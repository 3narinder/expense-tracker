# Server environment variables
# Configure allowed client origins for CORS in production.
# In Render, set this environment variable to your frontend origin(s).
CLIENT_ORIGINS=https://expense-tracker-ten-amber-28.vercel.app

# MongoDB connection strings
MONGO_URI_DEV=
MONGO_URI_PRODUCTION=

# AI insight usage controls
AI_MIN_TRANSACTION_COUNT=10
PLAN_BASIC_AI_LIMIT=2
PLAN_BASIC_AI_PERIOD=day
PLAN_BASIC_MAX_ACCOUNTS=1
PLAN_BASIC_MAX_PERSONAL_ACCOUNTS=1

PLAN_PRO_AI_LIMIT=10
PLAN_PRO_AI_PERIOD=day
PLAN_PRO_MAX_ACCOUNTS=2
PLAN_PRO_MAX_PERSONAL_ACCOUNTS=1
PLAN_PRO_MAX_BUSINESS_ACCOUNTS=1

PLAN_PREMIUM_AI_LIMIT=100
